---
import BaseHead from "../components/BaseHead.astro";
import RoosterMark from "../components/RoosterMark.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import rough from "roughjs";

const scratchGenerator = rough.generator();
const scratch = scratchGenerator.rectangle(-4, 1, 238, 62, {
  fill: "currentColor",
  fillStyle: "cross-hatch",
  hachureAngle: 72,
  hachureGap: 5.5,
  fillWeight: 2.2,
  stroke: "none",
  roughness: 1.7,
  bowing: 1.3,
  seed: 241,
});

const scratchPaths = scratchGenerator.toPaths(scratch).map((path) => ({
  ...path,
  d: path.d.replace(/-?\d+\.\d+/g, (value) => Number(value).toFixed(2)),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <script src="/theme.js" defer is:inline></script>
  </head>
  <body>
    <a class="fixed top-3 left-3 z-20 -translate-y-[150%] bg-[var(--ink)] px-3.5 py-2.5 text-[var(--paper)] focus:translate-y-0" href="#content">Skip to content</a>

    <header class="sticky top-0 z-10 isolate flex h-[84px] min-h-[84px] w-full items-center justify-between gap-[clamp(28px,4vw,64px)] bg-[var(--paper)] px-[var(--page-gutter)] max-[760px]:h-[68px] max-[760px]:min-h-[68px] max-[760px]:gap-2 max-[760px]:px-3" aria-label="Site header">
      <a class="grid size-12 flex-none place-items-center text-[var(--ink)] no-underline transition-transform active:scale-[0.96] motion-reduce:transition-none max-[760px]:size-11" href="/" aria-label="lmssieh, home">
        <RoosterMark />
      </a>

      <nav class="ml-auto flex min-w-0 items-center gap-[clamp(20px,2.4vw,36px)] max-[760px]:gap-1" aria-label="Primary navigation">
        <div class="flex items-center gap-[clamp(24px,3vw,44px)] max-[760px]:gap-1">
          <a class="inline-flex min-h-11 items-center whitespace-nowrap text-2xl no-underline hover:underline hover:underline-offset-[5px] max-[760px]:px-1.5 max-[760px]:text-lg" href="https://github.com/lmssiehdev">github</a>
          <a class="inline-flex min-h-11 items-center whitespace-nowrap text-2xl no-underline hover:underline hover:underline-offset-[5px] max-[760px]:px-1.5 max-[760px]:text-lg" href="mailto:lmssieh@proton.com">email</a>
        </div>
        <button class="grid size-11 flex-none cursor-pointer place-items-center border-0 bg-transparent p-0 text-[var(--ink)] transition-transform duration-150 hover:scale-[1.08] active:scale-[0.97] motion-reduce:transition-none" type="button" data-theme-toggle aria-label="Change color scheme"></button>
      </nav>
    </header>

    <main id="content">
      <section class="mx-auto w-[min(100%,calc(var(--max-width)+(2*var(--page-gutter))))] px-[var(--page-gutter)] pt-[clamp(72px,11vw,148px)] pb-[clamp(96px,14vw,180px)] max-[760px]:pt-[clamp(52px,16vw,88px)] max-[760px]:pb-24" aria-labelledby="intro-title">
        <h1 class="m-0 max-w-[32ch] text-[clamp(38px,4.35vw,64px)] leading-[1.16] font-normal tracking-[0.004em] text-pretty max-[760px]:text-[clamp(31px,8.4vw,46px)] max-[760px]:leading-[1.17]" id="intro-title">I’m lmssieh, a developer who ships with effort, care and taste.</h1>

        <p class="mt-[0.9em] max-w-[32ch] text-[clamp(38px,4.35vw,64px)] leading-[1.16] font-light tracking-[0.004em] text-pretty max-[760px]:text-[clamp(31px,8.4vw,46px)] max-[760px]:leading-[1.17]">
          Currently a founding engineer at <span class="scratch-redaction" data-private-company aria-hidden="true">
            <span class="scratch-redaction__name">nice try</span>
            <svg class="scratch-redaction__ink" viewBox="0 0 230 64" preserveAspectRatio="none" focusable="false">
              {scratchPaths.map((path) => <path d={path.d} fill={path.fill} stroke={path.stroke} stroke-width={path.strokeWidth} />)}
            </svg> </span
          ><span class="sr-only">a private company</span>, working across product, engineering and growth.
        </p>

        <p class="mt-[0.9em] max-w-[32ch] text-[clamp(38px,4.35vw,64px)] leading-[1.16] font-light tracking-[0.004em] text-pretty max-[760px]:text-[clamp(31px,8.4vw,46px)] max-[760px]:leading-[1.17]">
          Find me on <a class="underline decoration-1 underline-offset-[0.14em] hover:decoration-2" href="https://github.com/lmssiehdev">GitHub</a> or <a class="underline decoration-1 underline-offset-[0.14em] hover:decoration-2" href="mailto:lmssieh@proton.com">send me an email</a>.
        </p>
      </section>
    </main>
  </body>
</html>
